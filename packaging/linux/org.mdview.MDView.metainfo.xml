<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.mdview.MDView</id>
  <name>MD View</name>
  <summary>Native Markdown, text, and code editor</summary>
  <description>
    <p>MD View is a native Markdown, text, and code editor built with Rust and egui.</p>
    <p>It opens folders as workspaces, edits documents in tabs, and renders CommonMark and GFM with images, SVG, math, and Mermaid without a webview.</p>
  </description>
  <launchable type="desktop-id">mdview.desktop</launchable>
  <provides>
    <binary>mdview</binary>
  </provides>
  <categories>
    <category>Office</category>
    <category>TextEditor</category>
  </categories>
  <url type="homepage">https://github.com/jigonzalez930209/md-view-rs</url>
  <url type="bugtracker">https://github.com/jigonzalez930209/md-view-rs/issues</url>
