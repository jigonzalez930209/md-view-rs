<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MD View" Manufacturer="MD View" Version="0.11.1" UpgradeCode="9D8B7C3A-5E5A-4E65-9A73-2E6C2D2B6F10" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MD View is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="MD View" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MD View" />
    </StandardDirectory>
    <Feature Id="Main">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="MdViewExe" Source="target\release\mdview.exe" KeyPath="yes" />
      </Component>
      <Component Id="MarkdownAssociation" Guid="*">
        <RegistryKey Root="HKCU" Key="Software\Classes\MDView.Markdown">
          <RegistryValue Type="string" Value="Markdown Document" />
          <RegistryValue Name="DefaultIcon" Type="string" Value="[INSTALLFOLDER]mdview.exe,0" />
          <RegistryValue Name="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]mdview.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\.md">
          <RegistryValue Type="string" Value="MDView.Markdown" />
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\.markdown">
          <RegistryValue Type="string" Value="MDView.Markdown" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="AppShortcut" Name="MD View" Target="[INSTALLFOLDER]mdview.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\MDView" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
